flowchart TD
    A["同一时点T准备初始化数据"] --> B["海外仓快照＋易仓订单＋中台比例"]
    B --> C["计算海外仓不可用：在库－可用"]
    C --> D["订单不可用直挂团队，其他不可用按比例分摊"]
    D --> E["海外仓可用总量按中台比例分到团队"]
    E --> F["团队在库＝团队不可用＋团队可用"]
    F --> G{"初始化三项总量一致？"}
    G -- "否" --> X["停止初始化，排查时点、重复占用和数据口径"]
    G -- "是" --> H["记录快照时点T、流水游标和初始化差异"]
    H --> I{"后续数据来源"}
    I -- "在库流水" --> J["流水幂等挂团队，出库联动不可用"]
    I -- "易仓订单事件" --> K["按订单明细更新团队不可用"]
    I -- "海外仓周期快照" --> L["重算其他不可用并按比例分摊"]
    J --> M["后续可用＝在库－不可用"]
    K --> M
    L --> M
    M --> N{"同一时点三项总量与海外仓一致？"}
    N -- "是" --> O["完成，等待下一事件"]
    N -- "否" --> P["生成差异记录，只调整在库或不可用"]
    P --> M
